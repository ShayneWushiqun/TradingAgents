# LLM Providers (set the one you use)
OPENAI_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
OPENROUTER_API_KEY=

# Primary provider selection
# Options: openai, anthropic, google, xai, openrouter, ollama, openai_compatible
PRIMARY_PROVIDER=openrouter

# Override default models (optional, auto-detected from provider if not set)
# DEEP_THINK_LLM=
# QUICK_THINK_LLM=
# BACKEND_URL=

# OpenRouter model (used when PRIMARY_PROVIDER=openrouter)
PLANNER_MODEL_ID=

# OpenAI-compatible provider (Volcengine ARK / DashScope / DeepSeek / etc.)
# Used when PRIMARY_PROVIDER=openai_compatible
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_MODEL_ID=
