# LLM Providers (set the one you use)
OPENAI_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
ZHIPU_API_KEY=
OPENROUTER_API_KEY=
# Required MySQL URL for the web workstation runtime DB.
# Used by analysis_tasks, hot_radar_runs/items, and queue/history state.
# Local docker compose exposes MySQL on 127.0.0.1:3307.
TRADINGAGENTS_DB_URL=mysql+pymysql://tradingagents:tradingagents@127.0.0.1:3307/tradingagents

# Docker Compose deployment knobs. Compose injects an internal DB URL for the web container.
TRADINGAGENTS_WEB_PORT=8000
MYSQL_HOST_PORT=3307
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=tradingagents
MYSQL_USER=tradingagents
MYSQL_PASSWORD=change-me-db
# Keep disabled by default: scheduled work must not enqueue analysis tasks.
HOT_RADAR_SCHEDULER_ENABLED=0

# Optional web login guard. Set before exposing the workstation publicly.
TRADINGAGENTS_WEB_USERNAME=admin
TRADINGAGENTS_WEB_PASSWORD=
# Optional separate cookie signing secret; defaults to TRADINGAGENTS_WEB_PASSWORD.
TRADINGAGENTS_WEB_SECRET=
